# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-string"

# SQLite for local dev. For production, switch to a Postgres connection string
# (e.g. Neon / Supabase) and update lib/db/index.ts to use postgres-js.
DATABASE_URL="file:./data/tracker.db"

# Pre PO Ops Lead Time Rule (days). Editable in the Settings page.
NEXT_PUBLIC_DEFAULT_PRE_PO_OPS_LEAD_DAYS=21
