# ─────────────────────────────────────────────────────────────
# tracker_next environment template
#
# Copy to .env.local for local development. .env.local is in
# .gitignore and is never committed. For production deployments,
# set the same variables in your hosting provider's env config
# (Vercel: Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Two supported drivers — both go through Drizzle's libsql dialect.
#
#   Local dev (zero setup):
#     DATABASE_URL="file:./data/tracker.db"
#     TURSO_AUTH_TOKEN is NOT required for file: URLs
#
#   Production (Turso — libSQL on the edge):
#     DATABASE_URL="libsql://<db-name>-<org>.<region>.turso.io"
#     TURSO_AUTH_TOKEN="<full-access-token-from-turso-dashboard>"
#
# Provision a Turso DB at https://turso.tech — Mumbai (BOM) or
# Frankfurt (FRA) are good regions for KSA/UAE users.
DATABASE_URL="file:./data/tracker.db"
TURSO_AUTH_TOKEN=""

# ── Auth (NextAuth v5) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
# Must be 32+ chars; env validation refuses anything shorter.
NEXTAUTH_SECRET="replace-me-32-chars-minimum-please"

# Public URL of the app. localhost for dev, the Vercel production
# alias (e.g. https://project-xxxxx.vercel.app) in prod. Cookies
# and the sign-in/sign-out redirects are anchored to this value.
NEXTAUTH_URL="http://localhost:3000"

# ── Rule defaults ────────────────────────────────────────────
# Bootstrap value if the `pre_po_ops_lead_time_days` row is
# missing from the `settings` table. Admin can change the live
# value at runtime in Settings → Rules.
NEXT_PUBLIC_DEFAULT_PRE_PO_OPS_LEAD_DAYS=21
